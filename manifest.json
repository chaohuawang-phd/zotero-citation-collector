{
  "manifest_version": 2,
  "name": "正文引文收藏",
  "version": "1.0.2",
  "description": "在 Zotero 的 PDF 引用预览中收藏论文到指定分类，优先复用已有条目。",
  "applications": {
    "zotero": {
      "id": "citation-collector@research-tools.local",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*",
      "update_url": "https://citation-collector.invalid/updates.json"
    }
  }
}